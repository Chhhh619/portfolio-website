# Gemini API key used by the PocketRinggit demo (FinanceDemo).
# Get one at https://aistudio.google.com/app/apikey
#
# NOTE: This key is baked into the static build and visible to anyone who
# inspects the client. For a public portfolio, restrict the key tightly
# (HTTP referrer allowlist + low quota) or proxy the call through a
# backend/edge function before shipping to production.
VITE_GEMINI_API_KEY=
